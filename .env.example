# Copy to .env and fill in. Never commit .env.
# LLM providers (any one is enough; free tiers work)
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
# Optional local model: OLLAMA_HOST=http://127.0.0.1:11434

# Real help desk (Freshdesk free/trial account -> Profile / API key or a service account)
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your-freshdesk-api-key
# Optional: group that receives escalations
FRESHDESK_ESCALATION_GROUP_ID=

# Supervisor / agent models: fake (offline) | gemini[:model] | groq[:model] | ollama[:model]
# Comma-separated lists are tried in order when a provider is rate-limited.
SOPGUARD_JUDGE_LLM=fake
SOPGUARD_AGENT_LLM=gemini:gemini-3-flash-preview,groq:openai/gpt-oss-120b
# OpenAI-compatible upstream used by the /v1/chat/completions proxy
SOPGUARD_UPSTREAM=https://api.groq.com/openai/v1
# Append-only JSONL audit log (the Docker volume mounts this at /data)
SOPGUARD_AUDIT=/data/audit.jsonl
# Optional override for the proxy's compiled SOP (defaults to the bundled Northwind SOP)
# SOPGUARD_POLICY=
# Optional override for the Freshdesk worker/webhook SOP (defaults to /app/policies/... in Docker)
# SOPGUARD_FRESHDESK_POLICY=
# Token Freshdesk automations must send as header X-SOPGuard-Token
SOPGUARD_WEBHOOK_TOKEN=change-me-to-a-long-random-token
# Set to 1 to decide on tickets without writing back to Freshdesk
SOPGUARD_DRY_RUN=
